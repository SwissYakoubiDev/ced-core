# =================================================================
#  CLUB EMPREINTE DIGITALE - ENVIRONNEMENT EXEMPLE
#  Copiez ce fichier en .env et remplissez avec vos vraies valeurs
#  NE JAMAIS COMMITTER LE FICHIER .env FINAL SUR GITHUB
# =================================================================

# 1. BASE DE DONNÉES (PostgreSQL)
DATABASE_URL=postgresql://ced_admin:VOTRE_MOT_DE_PASSE@localhost:5432/club_empreinte_digitale
PGHOST=localhost
PGPORT=5432
PGUSER=ced_admin
PGPASSWORD=VOTRE_MOT_DE_PASSE
PGDATABASE=club_empreinte_digitale

# 2. AUTHENTIFICATION & SÉCURITÉ
# Générez des chaînes aléatoires longues pour la prod
SESSION_SECRET=votre_super_secret_session_tres_long_et_aleatoire
JWT_SECRET=votre_cle_secrete_jwt_tres_longue_et_aleatoire
REPLIT_AUTH_CLIENT_ID=votre_id_client_replit
REPLIT_AUTH_CLIENT_SECRET=votre_secret_client_replit

# 3. APIS EXTERNES (IA & Services)
OPENAI_API_KEY=sk-votre_cle_api_openai
ANTHROPIC_API_KEY=votre_cle_api_anthropic
GOOGLE_MAPS_API_KEY=votre_cle_api_google_maps
CURRENCYLAYER_API_KEY=votre_cle_api_currency

# 4. SERVICES FINANCIERS (Paiements)
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_stripe
STRIPE_PUBLIC_KEY=pk_test_votre_cle_publique_stripe
PAYPAL_CLIENT_ID=votre_client_id_paypal
PAYPAL_CLIENT_SECRET=votre_secret_paypal

# 5. COMMUNICATIONS (Emails & SMS)
SENDGRID_API_KEY=SG.votre_cle_api_sendgrid
TWILIO_ACCOUNT_SID=votre_sid_compte_twilio
TWILIO_AUTH_TOKEN=votre_token_auth_twilio
TWILIO_PHONE_NUMBER=+1234567890

# 6. STORAGE & CDN (Fichiers)
AWS_ACCESS_KEY_ID=votre_cle_acces_aws
AWS_SECRET_ACCESS_KEY=votre_cle_secrete_aws
AWS_REGION=eu-west-1
AWS_S3_BUCKET=ced-assets-bucket

# 7. MONITORING & ERREURS
SENTRY_DSN=

      Sign In | Sentry
    https://votre_dsn_sentry@sentry.io/123456

DATADOG_API_KEY=votre_cle_api_datadog
NEW_RELIC_LICENSE_KEY=votre_license_newrelic

# 8. CONFIGURATION RÉGIONALE (Défaut : Suisse)
DEFAULT_CURRENCY=CHF
DEFAULT_LANGUAGE=fr
TIMEZONE=Europe/Zurich
DATE_FORMAT=DD/MM/YYYY
PRAYER_CALCULATION_METHOD=MuslimWorldLeague

# 9. SÉCURITÉ AVANCÉE
CORS_ORIGIN=https://ced-halaltech.ch
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=900000
BCRYPT_ROUNDS=12
JWT_EXPIRY=24h

# 10. CACHE & SESSION (Redis)
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
SESSION_TTL=86400

# 11. FONCTIONNALITÉS (Feature Flags)
ENABLE_SUPER_IARP_PRO=true
ENABLE_QUANTUM_TRADING=false
ENABLE_METAVERSE_HAJJ=false
ENABLE_NEURAL_BANKING=false
ENABLE_BLOCKCHAIN_ZAKAT=true
ENABLE_CARBON_NEGATIVE=true
